{
  "expo": {
    "name": "BasoBas",
    "slug": "basobas-app",
    "version": "1.0.1",
    "scheme": "basobas",
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "experiments": {
      "tsconfigPaths": true,
      "typedRoutes": true
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "@clerk/expo",
      [
        "expo-maps",
        {
          "requestLocationPermission": true,
          "locationPermission": "Allow ${PRODUCT_NAME} to access this device's location?"
        }
      ]
    ],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FBF9F4"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.wcc.basobas",
      "appleTeamId": "4B67F6VF47"
    },
    "android": {
      "newArchEnabled": true,
      "package": "com.wcc.basobas",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyA3-iCgl3Ow2fxbIuZUsklb3gZymYiPHJI"
        }
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "versionCode": 2
    }
  }
}
