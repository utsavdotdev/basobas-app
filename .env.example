# ─── Dev Mode ────────────────────────────────────────────────────────────────
# Each developer sets their own .env file (gitignored) so they can work on
# any screen without being redirected by the auth flow.
#
# Options:
#   auth     — stay on (auth) screens (default for auth developers)
#   tenant   — auto-login as tenant and go to /(tenant)/(tabs)
#   landlord — auto-login as landlord and go to /(landlord)/(tabs)
#
# Unset or delete this var for production behavior (real auth redirects).
EXPO_PUBLIC_DEV_MODE=auth
